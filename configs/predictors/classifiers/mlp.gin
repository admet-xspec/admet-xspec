predictor/gin.singleton.constructor = @MlpClassifier
predictor = @predictor/gin.singleton()

MlpClassifier.params = {
    'hidden_layer_sizes': [512, 256],
    'activation': 'relu',
    'alpha': 0.001,
    'learning_rate_init': 0.001,
    'batch_size': 64,
    }

# Stopping criterion: with early stopping, training stops on the score of a
# held-out validation_fraction of the training data (accuracy) and keeps the
# best epoch's weights; without it, it stops on the training loss and keeps the
# last epoch's weights. Stops after n_iter_no_change epochs without an
# improvement > tol, or after max_iter epochs (logged as not converged).
MlpClassifier.early_stopping = True
MlpClassifier.validation_fraction = 0.1
MlpClassifier.n_iter_no_change = 10
MlpClassifier.tol = 1e-4
MlpClassifier.max_iter = 1000

# Include hyperparameter optimization config
include 'configs/predictors/classifiers/optimization/mlp_hyperparams.gin'
