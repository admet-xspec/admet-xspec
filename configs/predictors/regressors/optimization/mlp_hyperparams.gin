# 'n_hidden_layers', 'hidden_layer_width' (first layer) and 'layer_shape' are
# translated by the predictor into hidden_layer_sizes:
#   constant -> every layer is hidden_layer_width wide
#   funnel   -> each layer is half as wide as the previous one
#   free     -> each layer's width is sampled separately from the
#               'hidden_layer_width' range (as hidden_layer_width_2, _3, ...)

ProcessingPipeline.params_distribution = {
    'n_hidden_layers': ('int', 1, 3),
    'hidden_layer_width': ('int_log', 64, 2048),
    'layer_shape': ('categorical', ['constant', 'funnel', 'free']),
    'alpha': ('float_log', 1e-6, 1e-1),
    'learning_rate_init': ('float_log', 1e-4, 1e-2),
    'batch_size': ('categorical', [32, 64, 128, 256]),
    'activation': ('categorical', ['relu', 'tanh'])
    }

ProcessingPipeline.n_optim_cv_folds = 5
ProcessingPipeline.n_optim_iter = 100
ProcessingPipeline.target_metric = 'mse'
