#=====================[ADMET-Xspec]=====================#
#----------------------[pipeline]-----------------------#

include 'configs/processing_plans/train.gin'			    # we are training on set hyperparams
include 'configs/splitters/scaffold.gin'			        # scaffold split
include 'configs/featurizers/krfp.gin'				        # KRFP (Klekota & Roth FP) featurization
include 'configs/sim_filters/tanimoto_5p_to_whole.gin'      # drop all augmenting set (rat) molecular scaffolds
                                                            #   with Tanimoto similarity > 0.95 to human data
include 'configs/predictors/regressors/rf_attributed.gin'	# RandomForest attributed classifier

#------------------------[data]-------------------------#

ProcessingPipeline.datasets = [					            # listing datasets by friendly names
    'MAOA_human_pIC50',						                # (see data/datasets/registry.txt)
    'MAOA_rat_pIC50'
]

ProcessingPipeline.test_origin_dataset = 'MAOA_human_pIC50'	# only human data to populate the test set
ProcessingPipeline.task_setting = 'regression'

#========================================================#
# Advanced gin config settings
include 'configs/data_interface/data_interface.gin'
ProcessingPipeline.hyperparams_source_sim_filter = None
ProcessingPipeline.data_interface = %data_interface
ProcessingPipeline.splitter = %splitter
ProcessingPipeline.featurizer = %featurizer
ProcessingPipeline.sim_filter = %sim_filter
ProcessingPipeline.predictor = %predictor
